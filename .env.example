# Required. The bot will not start without these three.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SUPABASE_URL=your_supabase_url_here
# The bot uses the service-role key (it bypasses RLS and checks ownership in code). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Node environment
NODE_ENV=production

# Optional. Each feature stays off while its variable is unset (the bot logs which ones at startup).
# Free-text entry through OpenRouter:
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Receipt photos through ocr.space:
# OCR_SPACE_API_KEY=your_ocr_space_api_key_here
# Voice notes through Google Speech: the whole service-account JSON, or a key file path
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# Your numeric Telegram id, to receive owner alerts about failures:
# ALERT_CHAT_ID=
# Address behind the /dashboard button (defaults to the hosted dashboard):
# DASHBOARD_URL=https://your-dashboard.example
# Health endpoint port (also used by Railway):
# PORT=3000
