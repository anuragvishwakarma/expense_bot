# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Node Environment
NODE_ENV=production

# Optional: Webhook configuration (for production webhook mode)
# WEBHOOK_DOMAIN=your-domain.com
# WEBHOOK_PATH=/bot-webhook# OCR API Key (free tier from ocr.space or similar)
OCR_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# OpenRouter API key (for natural-language expense entry). Leave unset to disable the feature.
OPENROUTER_API_KEY=your_openrouter_api_key_here
